<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_orbit_enable"
        android:title="@string/orbit_enable"
        android:defaultValue="false"
        android:disableDependentsState="false"
        android:icon="@drawable/ic_baseline_cone_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_orbit_width" android:title="@string/orbit_width"
            android:defaultValue="100" app:minValue="0" app:maxValue="200"
            app:showTicks="false" app:seekBarIncrement="1" app:precision="0" app:unit="%"
            app:updatesContinuously="false" app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_orbit_strength" android:title="@string/orbit_strength"
            android:defaultValue="70" app:minValue="0" app:maxValue="100"
            app:showTicks="false" app:seekBarIncrement="1" app:precision="0" app:unit="%"
            app:updatesContinuously="false" app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_orbit_seconds" android:title="@string/orbit_seconds"
            android:defaultValue="25" app:minValue="5" app:maxValue="60"
            app:showTicks="false" app:seekBarIncrement="1" app:precision="0" app:unit=" s"
            app:updatesContinuously="false" app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_orbit_bass" android:title="@string/orbit_bass"
            android:defaultValue="100" app:minValue="0" app:maxValue="100"
            app:showTicks="false" app:seekBarIncrement="1" app:precision="0" app:unit="%"
            app:updatesContinuously="false" app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
    <Preference android:key="@string/key_orbit_reset" android:title="@string/orbit_reset"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
