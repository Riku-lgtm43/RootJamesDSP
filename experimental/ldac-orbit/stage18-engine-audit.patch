+	const size_t payloadSize = size - sizeof(effect_param_t);
+	if (param->psize > payloadSize)
+		return 0;
+	const size_t padding = (sizeof(int32_t) - (param->psize % sizeof(int32_t))) % sizeof(int32_t);
